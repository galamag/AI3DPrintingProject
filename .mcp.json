{
  "mcpServers": {
    "blender": {
      "command": "uv",
      "args": ["run", "--frozen", "mcp-for-blender"],
      "env": {
        "DISABLE_TELEMETRY": "true"
      }
    },
    "print": {
      "command": "uv",
      "args": ["run", "--frozen", "python", "-m", "print_mcp.server"]
    }
  }
}
